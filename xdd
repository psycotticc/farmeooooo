local function GoToOwnedCookingPot()
	local apt, aptName, aptFolder = FindOwnedApartment()
	if not apt then
		SetStatus("Sin depa — comprando...")
		if not BuyApartmentWithPot() then return false end
		apt, aptName, aptFolder = FindOwnedApartment()
		if not apt then return false end
	end

	local pots = GetCookingPots(apt)
	if #pots == 0 and aptFolder then
		pots = GetCookingPots(aptFolder)
	end

	local farmPot = pots[1]
	if not farmPot then
		SetStatus("No se encontró Cooking Pot")
		return false
	end

	if #pots > 1 then
		for i = 2, #pots do
			pcall(function() pots[i]:Destroy() end)
		end
		farmPot = pots[1]
	end

	ClearAroundPot(apt, farmPot, 16)

	local underCF = GetUnderPotCFrame(farmPot)
	if not underCF then return false end

	SetStatus("Yendo al depa (" .. tostring(aptName) .. ")...")
	local ok = SlowTravelUnderMap(underCF, "Viajando debajo de la olla...", 25, 4.5)
	if not ok then return false end
	if not AutoMS then return false end

	if not farmPot.Parent then
		local left = GetCookingPots(apt)
		if #left == 0 and aptFolder then left = GetCookingPots(aptFolder) end
		farmPot = left[1]
	end
	if not farmPot then return false end

	ClearAroundPot(apt, farmPot, 16)
	PlaceUnderPot(farmPot)
	SetStatus("Debajo de la olla")
	return true, farmPot
end

local function SellAllBags()
	SetStatus("Vendiendo bolsas...")
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	local order = {
		"Small Marshmallow Bag",
		"Medium Marshmallow Bag",
		"Large Marshmallow Bag",
	}

	while AutoMS do
		local bagName = nil
		for _, name in ipairs(order) do
			if GetToolCount(name) > 0 then
				bagName = name
				break
			end
		end
		if not bagName then break end

		local before = GetToolCount(bagName)
		local tool = GetTool(bagName)
		if not tool then break end

		SetStatus("Vendiendo " .. bagName .. "...")
		pcall(function() hum:EquipTool(tool) end)
		task.wait(0.15)

		HoldSellPrompt()
		task.wait(0.5)

		local after = GetToolCount(bagName)
		local sold = before - after
		if sold > 0 then
			TotalMoneyMade += sold * (BAG_PRICES[bagName] or 0)
		end
		CheckLimitCash()
	end

	SetStatus("Venta terminada")
	CheckLimitCash()
end

local function FinishFarmAndSell()
	StopLookAt()
	SetStatus("Yendo a vender...")

	if not SlowTravelUnderMap(SellPosition, "Viajando a venta...", TravelTime, 4.5) then
		return false
	end
	if not AutoMS then return false end

	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")

	DestroyPlatform()

	if hrp and hrp.Parent then
		local sellPos = SellPosition.Position
		hrp.CFrame = CFrame.new(sellPos.X, sellPos.Y + 3, sellPos.Z)
	end

	task.wait(0.35)
	ClearBlockersNear(SellPosition.Position, 16)
	StartLookAt(SellPosition.Position)

	SellAllBags()

	if not AutoMS then return false end

	StopLookAt()
	SetStatus("Venta terminada - comprando aquí mismo...")

	task.wait(0.7)
	ClearBlockersNear(SellPosition.Position, 16)

	local success = false
	for attempt = 1, 4 do
		if not AutoMS then break end
		SetStatus("Abriendo menú de compra... (" .. attempt .. "/4)")
		if AutoBuyIngredients(farmAmount) then
			success = true
			break
		end
		task.wait(1.1)
	end

	if success then
		SetStatus("Compra lista - yendo al depa")
	else
		SetStatus("No se pudo comprar")
	end

	task.wait(0.4)
	return success
end

local function CanDelete(obj)
	if not obj or not obj.Parent then return false end
	if IsProtectedObject(obj) then return false end
	if obj.Size.X > 250 and obj.Size.Z > 250 then return false end
	if obj.Position.Y < -30 then return false end
	return obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation")
end

