local function StartLookAt(pos)
	if not pos then return end
	lookTarget = typeof(pos) == "Vector3" and pos or (pos.Position or pos)

	local cam = workspace.CurrentCamera
	if cam and lookTarget then
		local camPos = cam.CFrame.Position
		pcall(function()
			cam.CFrame = CFrame.lookAt(camPos, lookTarget)
		end)
	end

	if lookConnection then return end

	lookConnection = RunService.RenderStepped:Connect(function()
		if not lookTarget then return end

		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local currentPos = hrp.Position
		local lookPos = Vector3.new(lookTarget.X, currentPos.Y, lookTarget.Z)

		if (lookPos - currentPos).Magnitude > 0.08 then
			hrp.CFrame = CFrame.new(currentPos, lookPos)
		end
	end)
end

local function StopLookAt()
	lookTarget = nil
	if lookConnection then
		lookConnection:Disconnect()
		lookConnection = nil
	end
end

local function GetApartmentsFolder()
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Apartments")
end

local function IsAllowedAptFolder(folder)
	if not folder then return false end
	return string.find(folder.Name, ALLOWED_APT_PREFIX, 1, true) == 1
end

local function GetOccupationText(board)
	if not board then return "" end
	for _, d in ipairs(board:GetDescendants()) do
		if d.Name == "Occupation" and (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) then
			return d.Text or ""
		end
	end
	return ""
end

local function GetBoard(aptModel)
	if not aptModel then return nil end
	return aptModel:FindFirstChild("Board", true) or aptModel:FindFirstChild("Board")
end

local function GetCookingPots(apt)
	local pots = {}
	if not apt then return pots end
	for _, d in ipairs(apt:GetDescendants()) do
		local n = string.lower(d.Name or "")
		if n == "cooking pot" or n == "cookingpot" then
			table.insert(pots, d)
		end
	end
	return pots
end

local function GetPotPart(pot)
	if not pot then return nil end
	if pot:IsA("BasePart") then return pot end
	return pot:FindFirstChildWhichIsA("BasePart", true)
end

local function GetUnderPotPosition(pot)
	local part = GetPotPart(pot)
	if not part then return nil end
	return part.Position - Vector3.new(0, UNDER_POT_OFFSET, 0)
end

local function GetUnderPotCFrame(pot)
	local pos = GetUnderPotPosition(pot)
	if not pos then return nil end
	return CFrame.new(pos)
end

local function FindOwnedApartment()
	local apartments = GetApartmentsFolder()
	if not apartments then return nil end
	local myName = string.lower(LocalPlayer.Name)
	local myDisplay = string.lower(LocalPlayer.DisplayName)
	for _, aptFolder in ipairs(apartments:GetChildren()) do
		if not IsAllowedAptFolder(aptFolder) then continue end
		local apt = aptFolder:FindFirstChild("Apartment") or aptFolder
		local board = GetBoard(apt) or GetBoard(aptFolder)
		if board then
			local text = string.lower(GetOccupationText(board))
			if text ~= "" and (string.find(text, myName, 1, true) or string.find(text, myDisplay, 1, true)) then
				return apt, aptFolder.Name, aptFolder
			end
		end
	end
	return nil
end

local function IsAptFree(board)
	local text = string.lower(GetOccupationText(board))
	if text == "" or text == "empty" or text == "for sale" or text == "available"
		or string.find(text, "vacant", 1, true) or string.find(text, "none", 1, true)
		or string.find(text, "unoccupied", 1, true) or string.find(text, "libre", 1, true)
		or string.find(text, "sale", 1, true) or string.find(text, "buy", 1, true)
		or text == "---" or text == "-" or text == "n/a" then
		return true
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if string.find(text, string.lower(plr.Name), 1, true)
			or string.find(text, string.lower(plr.DisplayName), 1, true) then
			return false
		end
	end
	return #text < 3
end

local function GetFrontOfBoardCFrame(boardPart)
	local look = boardPart.CFrame.LookVector
	local front = -look
	local stand = boardPart.Position + front * 2.2
	stand = Vector3.new(stand.X, boardPart.Position.Y - 1.2, stand.Z)
	if stand.Y < 1 then stand = Vector3.new(stand.X, math.max(boardPart.Position.Y - 1.2, 3), stand.Z) end
	return CFrame.new(stand, boardPart.Position)
end

local function FindFreeCompactWalkup()
	local apartments = GetApartmentsFolder()
	if not apartments then return nil, "no_folder" end
	local candidates = {}
	local totalAllowed = 0
	for _, aptFolder in ipairs(apartments:GetChildren()) do
		if not IsAllowedAptFolder(aptFolder) then continue end
		totalAllowed += 1
		local apt = aptFolder:FindFirstChild("Apartment") or aptFolder
		local board = GetBoard(apt) or GetBoard(aptFolder)
		if not board then continue end
		if not IsAptFree(board) then continue end
		local pots = GetCookingPots(apt)
		if #pots == 0 then pots = GetCookingPots(aptFolder) end
		if #pots == 0 then continue end
		local boardPart = board:IsA("BasePart") and board or board:FindFirstChildWhichIsA("BasePart", true)
		if not boardPart then continue end
		table.insert(candidates, {
			apt = apt, aptFolder = aptFolder, name = aptFolder.Name,
			board = board, boardPos = boardPart.Position, boardPart = boardPart,
			cf = GetFrontOfBoardCFrame(boardPart),
			prompt = board:FindFirstChildOfClass("ProximityPrompt") or board:FindFirstChildWhichIsA("ProximityPrompt", true),
		})
	end
	if totalAllowed == 0 then return nil, "no_allowed" end
	if #candidates == 0 then return nil, "full" end
	return candidates[math.random(1, #candidates)], nil
end

local function IsProtectedObject(obj)
	if not obj then return true end
	if obj.Name == "SafePlatform" or obj:IsA("Terrain") then return true end
	if obj:IsA("ProximityPrompt") then return true end

	local n = string.lower(obj.Name or "")

	if n == "board" or string.find(n, "board", 1, true) then return true end
	if obj:FindFirstAncestor("Board") then return true end

	if n == "cooking pot" or n == "cookingpot" or string.find(n, "cooking", 1, true) then return true end

	if n == "lamont bell" or string.find(n, "lamont", 1, true) or string.find(n, "bell", 1, true) then
		return true
	end

	local ancestor = obj
	while ancestor and ancestor ~= workspace and ancestor ~= game do
		local an = string.lower(ancestor.Name or "")
		if an == "lamont bell" or string.find(an, "lamont", 1, true) then return true end
		if an == "npcs" or an == "npc" then return true end
		ancestor = ancestor.Parent
	end

	local model = obj:FindFirstAncestorWhichIsA("Model")
	if model and Players:GetPlayerFromCharacter(model) then return true end
	if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) then return true end

	if obj:IsA("Humanoid") or obj:FindFirstChildOfClass("Humanoid") then return true end

	return false
end

local function IsWall(obj)
	if not obj or not obj:IsA("BasePart") then return false end
	local n = string.lower(obj.Name or "")
	if n == "wall" or string.find(n, "wall", 1, true) or string.find(n, "pared", 1, true) then return true end
	if string.find(n, "fence", 1, true) or string.find(n, "barrier", 1, true) then return true end
	local s = obj.Size
	if s.Y > 4 and (s.X < 4 or s.Z < 4) then return true end
	if s.Y > 6 and s.X * s.Z < 50 then return true end
	return false
end

local function ClearBlockersNear(pos, radius)
	radius = radius or 12
	if not pos then return end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if not (obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation")) then continue end
		if IsProtectedObject(obj) then continue end
		local ok, dist = pcall(function() return (obj.Position - pos).Magnitude end)
		if not ok or dist > radius then continue end
		if IsWall(obj) or dist < 5 then
			pcall(function() obj:Destroy() end)
		end
	end
end

local function ClearApartmentWalls(apt)
	if not apt then return end
	for _, obj in ipairs(apt:GetDescendants()) do
		if not (obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation")) then continue end
		if IsProtectedObject(obj) then continue end
		if IsWall(obj) then
			pcall(function() obj:Destroy() end)
		end
	end
end

local function ClearAroundPot(apt, pot, radius)
	radius = radius or 16
	local part = GetPotPart(pot)
	if not part then return end
	local potPos = part.Position
	local root = apt or workspace
	for _, obj in ipairs(root:GetDescendants()) do
		if not (obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation")) then continue end
		if IsProtectedObject(obj) then continue end
		if pot and (obj == pot or obj:IsDescendantOf(pot)) then continue end
		local ok, dist = pcall(function() return (obj.Position - potPos).Magnitude end)
		if ok and dist <= radius then
			pcall(function() obj:Destroy() end)
		end
	end
end

local function KeepOnePot(apt, aptFolder)
	local pots = GetCookingPots(apt)
	if #pots == 0 and aptFolder then
		pots = GetCookingPots(aptFolder)
	end
	if #pots == 0 then return nil end
	if #pots == 1 then return pots[1] end

	local keep = pots[1]
	for i = 2, #pots do
		pcall(function() pots[i]:Destroy() end)
	end
	return keep
end

local function EnlargePrompt(prompt, dist)
	if not prompt or not prompt:IsA("ProximityPrompt") then return end
	pcall(function()
		prompt.MaxActivationDistance = dist or 50
		prompt.RequiresLineOfSight = false
	end)
end

local function EnlargePotPrompt(pot)
	if not pot then return end
	for _, d in ipairs(pot:GetDescendants()) do
		if d:IsA("ProximityPrompt") then EnlargePrompt(d, POT_PROMPT_DIST) end
	end
end

local function EnlargePromptOn(obj, dist)
	if not obj then return end
	if obj:IsA("ProximityPrompt") then EnlargePrompt(obj, dist or 50) return end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("ProximityPrompt") then EnlargePrompt(d, dist or 50) end
	end
end

local function fireConnections(obj)
	if not obj or not getconnections then return 0 end
	local n = 0
	for _, name in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up", "InputBegan"}) do
		pcall(function()
			local sig = obj[name]
			if typeof(sig) == "RBXScriptSignal" then
				for _, c in ipairs(getconnections(sig)) do
					pcall(function()
						if c.Fire then c:Fire() n += 1
						elseif c.Function then c.Function() n += 1 end
					end)
				end
			end
		end)
	end
	return n
end

local function clickGui(gui)
	if not gui then return 0 end
	local n = fireConnections(gui)
	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("GuiButton") then n += fireConnections(d) end
	end
	if gui:IsA("GuiButton") then n += fireConnections(gui) end
	return n
end

local function waitFor(fn, timeout)
	timeout = timeout or 8
	local t = tick()
	while tick() - t < timeout do
		local ok, v = pcall(fn)
		if ok and v then return v end
		task.wait(0.1)
	end
	return nil
end

local function FireBoardPrompt(board, boardPart)
	if not board then return false end
	local prompt = board:FindFirstChildOfClass("ProximityPrompt") or board:FindFirstChildWhichIsA("ProximityPrompt", true)
	if not prompt then return false end
	EnlargePrompt(prompt, 50)

	local pos = boardPart and boardPart.Position or board:GetPivot().Position
	StartLookAt(pos)

	local hold = (prompt.HoldDuration and prompt.HoldDuration > 0) and (prompt.HoldDuration + 0.15) or 0.55
	pcall(function() if fireproximityprompt then fireproximityprompt(prompt, hold) end end)
	pcall(function() prompt:InputHoldBegin() end)
	task.wait(hold)
	pcall(function() prompt:InputHoldEnd() end)
	return true
end

local function HoldAnyPromptNear(pos, maxDist)
	maxDist = maxDist or 40
	ClearBlockersNear(pos, 14)
	local best, bestDist = nil, maxDist
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local parent = obj.Parent
			local ppos = nil
			if parent and parent:IsA("BasePart") then ppos = parent.Position
			elseif parent then
				local bp = parent:FindFirstChildWhichIsA("BasePart", true)
				if bp then ppos = bp.Position end
			end
			if ppos then
				local d = (ppos - pos).Magnitude
				if d < bestDist then bestDist = d best = obj end
			end
		end
	end
	if not best then return false end
	EnlargePrompt(best, 50)

	local parent = best.Parent
	local lookPos = pos
	if parent and parent:IsA("BasePart") then lookPos = parent.Position
	elseif parent then
		local bp = parent:FindFirstChildWhichIsA("BasePart", true)
		if bp then lookPos = bp.Position end
	end
	StartLookAt(lookPos)

	local holdTime = (best.HoldDuration and best.HoldDuration > 0) and (best.HoldDuration + 0.15) or 0.55
	pcall(function() if fireproximityprompt then fireproximityprompt(best, holdTime) end end)
	pcall(function() best:InputHoldBegin() end)
	task.wait(holdTime)
	pcall(function() best:InputHoldEnd() end)
	return true
end

local function CleanApartmentForFarm(apt, aptFolder, board, boardPart)
	if not apt then return nil end

	SetStatus("Limpiando paredes...")
	ClearApartmentWalls(apt)
	if aptFolder and aptFolder ~= apt then
		ClearApartmentWalls(aptFolder)
	end

	if boardPart then
		SetStatus("Limpiando cerca del Board...")
		ClearBlockersNear(boardPart.Position, 14)
	end

	SetStatus("Dejando solo 1 Cooking Pot...")
	local keepPot = KeepOnePot(apt, aptFolder)

	if keepPot then
		SetStatus("Limpiando cerca de la olla...")
		ClearAroundPot(apt, keepPot, 16)
		if aptFolder then
			ClearAroundPot(aptFolder, keepPot, 16)
		end
	end

	return keepPot
end

local function DestroyPlatform()
	if stayConnection then stayConnection:Disconnect() stayConnection = nil end
	if currentPlatform then currentPlatform:Destroy() currentPlatform = nil end
	isProtecting = false
end

local function ForceGoUp()
	if not isProtecting or not currentPlatform then
		isProtecting = false
		return
	end
	SetStatus("Subiendo...")
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local px = currentPlatform.Position.X
	local pz = currentPlatform.Position.Z
	local targetY = math.max(originalY, 25)
	if targetY < 20 then targetY = 25 end
	local upTween = TweenService:Create(currentPlatform, TweenInfo.new(2.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(px, targetY - 4.3, pz)
	})
	upTween:Play()
	upTween.Completed:Wait()
	DestroyPlatform()
	if hrp and hrp.Parent then
		hrp.CFrame = CFrame.new(px, targetY, pz)
	end
	StopLookAt()
end

local function EnsurePlatform()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	if isProtecting and currentPlatform and currentPlatform.Parent then return true end
	isProtecting = true
	originalY = math.max(hrp.Position.Y, 5)
	local currentPos = hrp.Position
	currentPlatform = Instance.new("Part")
	currentPlatform.Name = "SafePlatform"
	currentPlatform.Size = Vector3.new(12, 1.5, 12)
	currentPlatform.Anchored = true
	currentPlatform.CanCollide = true
	currentPlatform.Material = Enum.Material.Neon
	currentPlatform.Color = Color3.fromRGB(255, 80, 160)
	currentPlatform.Transparency = 0.2
	currentPlatform.CFrame = CFrame.new(currentPos.X, currentPos.Y - 4, currentPos.Z)
	currentPlatform.Parent = workspace
	stayConnection = RunService.Heartbeat:Connect(function()
		if hrp and hrp.Parent and currentPlatform and currentPlatform.Parent then
			local p = currentPlatform.Position
			hrp.CFrame = CFrame.new(p.X, p.Y + 4.3, p.Z)
		end
	end)
	return true
end

local function SlowTravelUnderMap(targetCF, label, travelSeconds, riseSeconds)
	travelSeconds = travelSeconds or TravelTime
	riseSeconds = riseSeconds or 4.5
	if not EnsurePlatform() then return false end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	SetStatus(label or "Viajando bajo el mapa...")
	local downTween = TweenService:Create(currentPlatform, TweenInfo.new(3.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
		CFrame = CFrame.new(currentPlatform.Position.X, SafeHeight, currentPlatform.Position.Z)
	})
	downTween:Play()
	downTween.Completed:Wait()
	if not AutoMS then ForceGoUp() return false end
	local target = targetCF.Position
	local destY = target.Y
	local moveTween = TweenService:Create(currentPlatform, TweenInfo.new(travelSeconds, Enum.EasingStyle.Linear), {
		CFrame = CFrame.new(target.X, SafeHeight, target.Z)
	})
	moveTween:Play()
	while moveTween.PlaybackState == Enum.PlaybackState.Playing do
		if not AutoMS then moveTween:Cancel() ForceGoUp() return false end
		task.wait(0.1)
	end
	if not AutoMS then ForceGoUp() return false end
	SetStatus("Subiendo...")
	local upTween = TweenService:Create(currentPlatform, TweenInfo.new(riseSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(target.X, destY - 4.3, target.Z)
	})
	upTween:Play()
	while upTween.PlaybackState == Enum.PlaybackState.Playing do
		if not AutoMS then upTween:Cancel() ForceGoUp() return false end
		task.wait(0.1)
	end
	if not AutoMS then ForceGoUp() return false end
	task.wait(0.2)
	return true
end

local function GoDownAndUp(waitTime)
	if not EnsurePlatform() then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	originalY = math.max(hrp.Position.Y, 5)
	local px = currentPlatform.Position.X
	local pz = currentPlatform.Position.Z
	SetStatus("Bajando...")
	local downTween = TweenService:Create(currentPlatform, TweenInfo.new(2.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(px, SafeHeight, pz)
	})
	downTween:Play()
	downTween.Completed:Wait()
	if not AutoMS then ForceGoUp() return end
	SetStatus("Esperando abajo...")
	local startWait = tick()
	while tick() - startWait < waitTime do
		if not AutoMS then ForceGoUp() return end
		task.wait(0.1)
	end
	SetStatus("Subiendo...")
	local upTween = TweenService:Create(currentPlatform, TweenInfo.new(2.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(px, originalY - 4.3, pz)
	})
	upTween:Play()
	upTween.Completed:Wait()
	if not AutoMS then ForceGoUp() return end
end

local function AutoBuyIngredients(amount)
	if not AutoMS then return false end
	SetStatus("Comprando x" .. amount .. "...")

	local npc = workspace:FindFirstChild("Folders")
		and workspace.Folders:FindFirstChild("NPCs")
		and workspace.Folders.NPCs:FindFirstChild("Lamont Bell")
	local torso = npc and npc:FindFirstChild("UpperTorso")
	local prompt = torso and torso:FindFirstChildOfClass("ProximityPrompt")
	if not prompt and npc then
		prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
	end
	if not prompt then
		SetStatus("No ProximityPrompt")
		return false
	end

	local npcPos = (torso and torso.Position) or (npc and npc:GetPivot().Position) or ShopPosition.Position
	ClearBlockersNear(npcPos, 14)
	EnlargePrompt(prompt, 50)
	EnlargePromptOn(npc, 50)
	StartLookAt(npcPos)

	pcall(function()
		if fireproximityprompt then fireproximityprompt(prompt, 0.9) end
	end)
	pcall(function() prompt:InputHoldBegin() end)
	task.wait(0.9)
	pcall(function() prompt:InputHoldEnd() end)

	if not AutoMS then return false end

	local option1 = waitFor(function()
		local ui = LocalPlayer.PlayerGui:FindFirstChild("DialogueUI")
		if not ui then return nil end
		local list = ui:FindFirstChild("MainFrame")
			and ui.MainFrame:FindFirstChild("ResponseFrame")
			and ui.MainFrame.ResponseFrame:FindFirstChild("List")
		if not list then return nil end
		local one = list:FindFirstChild("1")
		if not one then return nil end
		local frame = one:FindFirstChild("Frame")
		if frame and frame.AbsoluteSize.X > 2 then return one end
		return nil
	end, 10)

	if not option1 then
		SetStatus("No abrió diálogo")
		return false
	end

	task.wait(0.45)
	if not AutoMS then return false end

	for _ = 1, 10 do
		if not AutoMS then return false end
		local frame = option1:FindFirstChild("Frame")
		local dialogue = option1:FindFirstChild("Dialogue")
		if frame then clickGui(frame) end
		task.wait(0.12)
		if dialogue then clickGui(dialogue) end
		task.wait(0.12)
		clickGui(option1)
		if LocalPlayer.PlayerGui:FindFirstChild("Shop") then break end
		task.wait(0.15)
	end

	local shop = waitFor(function()
		return LocalPlayer.PlayerGui:FindFirstChild("Shop")
	end, 6)
	if not shop then
		SetStatus("Shop no abrió")
		return false
	end
	task.wait(0.4)
	if not AutoMS then return false end

	local main = shop:FindFirstChild("Main")
	local scrolling = main and main:FindFirstChild("ScrollingFrame")
	if not scrolling then return false end

	local children = scrolling:GetChildren()
	local targets, seen = {}, {}
	local function addTarget(obj)
		if obj and not seen[obj] then seen[obj] = true table.insert(targets, obj) end
	end
	addTarget(children[5])
	addTarget(children[6])
	addTarget(scrolling:FindFirstChild("PurchaseableItem"))
	for _, c in ipairs(children) do
		if c.Name == "PurchaseableItem" then addTarget(c) end
	end

	SetStatus("Comprando items x" .. amount .. "...")
	for round = 1, amount do
		if not AutoMS then return false end
		for _, item in ipairs(targets) do
			if not AutoMS then return false end
			clickGui(item)
			task.wait(0.9)
		end
	end

	local exitBtn = main and main:FindFirstChild("Exit")
	if exitBtn then
		task.wait(0.2)
		clickGui(exitBtn)
	end
	task.wait(0.4)
	SetStatus("Compra lista")
	return true
end

