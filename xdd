				LblFarmCfg:SetText("Farmeo: " .. tostring(farmAmount) .. " ($" .. tostring(farmAmount * COST_PER_CYCLE) .. ")")
				LblLimit:SetText("Limit: $" .. tostring(limitCashAmount))
			end
			if StatusLabel and StatusLabel.SetText then
				StatusLabel:SetText("Status: " .. tostring(CurrentStatus))
			end
		end)
	end
end)

