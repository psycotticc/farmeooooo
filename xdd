local function BuyApartmentWithPot()
	if FindOwnedApartment() then
		SetStatus("Ya tienes departamento")
		return true
	end

	local free = FindFreeCompactWalkup()
	if not free then
		SetStatus("No hay departamentos libres")
		return false
	end

	SetStatus("Yendo al Board " .. tostring(free.name) .. "...")
	if not SlowTravelUnderMap(free.cf, "Viajando al Board...", 28, 5.0) then
		return false
	end
	if not AutoMS then return false end

	if currentPlatform and currentPlatform.Parent and free.boardPart then
		local look = free.boardPart.CFrame.LookVector
		local closer = free.boardPart.Position + (-look) * 1.6
		closer = Vector3.new(closer.X, free.boardPart.Position.Y - 1.2, closer.Z)

		local adj = TweenService:Create(currentPlatform, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.new(closer.X, closer.Y - 4.3, closer.Z)
		})
		adj:Play()
		adj.Completed:Wait()
	end

	SetStatus("Limpiando paredes + cerca del Board + dejando 1 olla...")
	local keptPot = CleanApartmentForFarm(free.apt, free.aptFolder, free.board, free.boardPart)

	ClearBlockersNear(free.boardPos, 14)
	StartLookAt(free.boardPos)
	task.wait(0.35)

	SetStatus("Comprando departamento...")
	for _ = 1, 8 do
		if not AutoMS then return false end
		if FindOwnedApartment() then break end
		FireBoardPrompt(free.board, free.boardPart)
		task.wait(0.7)
	end

	local bought = FindOwnedApartment() ~= nil
	SetStatus(bought and "Departamento comprado!" or "No se pudo comprar")
	task.wait(0.5)
	return bought
end

local function PlaceUnderPot(farmPot)
