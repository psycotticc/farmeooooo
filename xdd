MoveSection:Toggle({
	Name = "Spin Bot",
	Flag = "spin",
	Default = false,
	Callback = function(state) ToggleSpinBot(state) end
})

MoveSection:Slider({
	Name = "Spin Speed",
	Flag = "spin_speed",
	Min = 1,
	Max = 100,
	Default = 50,
	Callback = function(val)
		spinSpeed = math.clamp(math.floor(val), 1, 100)
	end
})

MoveSection:Toggle({
	Name = "Stretch",
	Flag = "stretch",
	Default = false,
	Callback = function(state)
		stretchOn = state
		if stretchOn then
			ApplyStretch(stretchValue)
		else
			if stretchConnection then
				stretchConnection:Disconnect()
				stretchConnection = nil
			end
		end
	end
})

MoveSection:Slider({
	Name = "Stretch Value",
	Flag = "stretch_value",
	Min = 30,
	Max = 100,
	Default = 100,
	Callback = function(val)
		stretchValue = math.clamp(math.floor(val), 30, 100)
		if stretchOn then ApplyStretch(stretchValue) end
	end
})

DeleteSection:Toggle({
	Name = "Delete Mode",
	Flag = "delete_mode",
	Default = false,
	Callback = function(state) deleteMode = state end
})

DeleteSection:Button({
	Name = "Restablecer último",
	Callback = function()
		if #deletedObjects > 0 then
			local last = table.remove(deletedObjects)
			if last and last.object then
				pcall(function()
					last.object.Parent = last.parent
					last.object.CFrame = last.cframe
					last.object.Size = last.size
					last.object.Color = last.color
					last.object.Transparency = last.transparency
					last.object.CanCollide = last.cancollide
					last.object.Anchored = last.anchored
				end)
			end
			pcall(function()
				Library:Notification({
					Title = "Restore",
					Text = "Restaurado (" .. #deletedObjects .. ")",
					Duration = 2
				})
			end)
		else
			pcall(function()
				Library:Notification({
					Title = "Restore",
					Text = "Nada que restaurar",
					Duration = 2
				})
			end)
		end
	end
})

