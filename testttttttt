--[[
    GravityHub - Lamont buy test
    Misma llegada que en PC: se queda EN la plataforma a Y de ShopPosition
    (no se destruye al llegar, por eso no se cae)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local GuiService = game:GetService("GuiService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Misma posicion que el script de PC
local ShopPosition = CFrame.new(511.364, 3.575, 597.820)
local SafeHeight = -8
local TravelTime = 32

local platform = nil
local stayConn = nil
local lookConn = nil

local function notify(msg)
    print("[LamontTest]", msg)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Lamont Test",
            Text = tostring(msg),
            Duration = 3,
        })
    end)
end

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function zeroVel(hrp)
    if not hrp then return end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- ==================== LOOK AT (como PC) ====================
local function stopLookAt()
    if lookConn then lookConn:Disconnect() lookConn = nil end
end

local function startLookAt(pos)
    stopLookAt()
    if not pos then return end
    local target = pos
    local cam = workspace.CurrentCamera
    if cam then
        pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target) end)
    end
    lookConn = RunService.RenderStepped:Connect(function()
        local hrp = getHRP()
        if not hrp then return end
        local p = hrp.Position
        local look = Vector3.new(target.X, p.Y, target.Z)
        if (look - p).Magnitude > 0.05 then
            hrp.CFrame = CFrame.new(p, look)
        end
        local c = workspace.CurrentCamera
        if c then
            pcall(function() c.CFrame = CFrame.lookAt(c.CFrame.Position, target) end)
        end
    end)
end

-- ==================== PLATFORM (igual que PC) ====================
local function destroyPlatform()
    if stayConn then stayConn:Disconnect() stayConn = nil end
    if platform then pcall(function() platform:Destroy() end) platform = nil end
end

local function ensurePlatform()
    local hrp = getHRP()
    if not hrp then
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        hrp = char:WaitForChild("HumanoidRootPart", 8)
    end
    if not hrp then return false end
    if platform and platform.Parent then return true end

    local pos = hrp.Position
    platform = Instance.new("Part")
    platform.Name = "SafePlatform"
    platform.Size = Vector3.new(12, 1.5, 12)
    platform.Anchored = true
    platform.CanCollide = true
    platform.Material = Enum.Material.Neon
    platform.Color = Color3.fromRGB(168, 85, 247)
    platform.Transparency = 0.2
    platform.CFrame = CFrame.new(pos.X, pos.Y - 4, pos.Z)
    platform.Parent = workspace

    -- Igual que PC: HRP siempre a platform.Y + 4.3
    stayConn = RunService.Heartbeat:Connect(function()
        local h = getHRP()
        if h and platform and platform.Parent then
            local p = platform.Position
            h.CFrame = CFrame.new(p.X, p.Y + 4.3, p.Z)
            zeroVel(h)
        end
    end)
    return true
end

-- Misma logica que SlowTravelUnderMap del PC
local function travelToShop()
    if not ensurePlatform() then return false end
    local hrp = getHRP()
    if not hrp then return false end

    local target = ShopPosition.Position
    local destY = target.Y -- 3.575 como en PC

    notify("Bajando...")
    local down = TweenService:Create(platform, TweenInfo.new(3.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        CFrame = CFrame.new(platform.Position.X, SafeHeight, platform.Position.Z)
    })
    down:Play()
    down.Completed:Wait()

    notify("Viajando a tienda...")
    local move = TweenService:Create(platform, TweenInfo.new(TravelTime, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(target.X, SafeHeight, target.Z)
    })
    move:Play()
    move.Completed:Wait()

    notify("Subiendo...")
    -- Igual PC: plataforma a destY - 4.3  => personaje a destY
    local up = TweenService:Create(platform, TweenInfo.new(4.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(target.X, destY - 4.3, target.Z)
    })
    up:Play()
    up.Completed:Wait()
    task.wait(0.3)

    -- NO destruir plataforma (en PC tampoco se destruye al comprar)
    -- El stayConn te mantiene en Y = destY encima de la plataforma
    notify("En posicion de tienda (como PC)")
    return true
end

-- ==================== NPC ====================
local function getLamont()
    local folders = workspace:FindFirstChild("Folders")
    local npcs = folders and folders:FindFirstChild("NPCs")
    local npc = npcs and npcs:FindFirstChild("Lamont Bell")
    if not npc then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Model") and string.lower(d.Name) == "lamont bell" then
                return d
            end
        end
    end
    return npc
end

local function getLamontPrompt(npc)
    if not npc then return nil end
    local torso = npc:FindFirstChild("UpperTorso") or npc:FindFirstChild("Torso") or npc:FindFirstChild("HumanoidRootPart")
    local prompt = torso and torso:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then
        prompt = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    return prompt, torso
end

local function enlargeAndFirePrompt(prompt)
    if not prompt then return false end
    pcall(function()
        prompt.MaxActivationDistance = 40
        prompt.RequiresLineOfSight = false
    end)
    local hold = (prompt.HoldDuration and prompt.HoldDuration > 0) and (prompt.HoldDuration + 0.15) or 0.6
    pcall(function()
        if fireproximityprompt then fireproximityprompt(prompt, hold) end
    end)
    pcall(function() prompt:InputHoldBegin() end)
    task.wait(hold)
    pcall(function() prompt:InputHoldEnd() end)
    return true
end

-- ==================== CLICK ====================
local function fireConnections(obj)
    if not obj then return end
    local names = { "Activated", "MouseButton1Click", "MouseButton1Down", "TouchTap" }
    if getconnections then
        for _, name in ipairs(names) do
            pcall(function()
                local sig = obj[name]
                if typeof(sig) == "RBXScriptSignal" then
                    for _, c in ipairs(getconnections(sig)) do
                        pcall(function()
                            if c.Fire then c:Fire()
                            elseif c.Function then c.Function() end
                        end)
                    end
                end
            end)
        end
    end
    if firesignal then
        for _, name in ipairs(names) do
            pcall(function()
                local sig = obj[name]
                if typeof(sig) == "RBXScriptSignal" then firesignal(sig) end
            end)
        end
    end
end

local function getCenter(gui)
    local ok, pos = pcall(function()
        local p = gui.AbsolutePosition
        local s = gui.AbsoluteSize
        local inset = Vector2.new(0, 0)
        pcall(function() inset = GuiService:GetGuiInset() end)
        return Vector2.new(p.X + s.X / 2, p.Y + s.Y / 2 + inset.Y)
    end)
    return ok and pos or nil
end

local function clickOnce(gui)
    if not gui then return false end
    fireConnections(gui)
    local center = getCenter(gui)
    if center then
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
            task.wait(0.04)
            VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
        end)
        pcall(function()
            VirtualInputManager:SendTouchEvent(center.X, center.Y, true, game)
            task.wait(0.04)
            VirtualInputManager:SendTouchEvent(center.X, center.Y, false, game)
        end)
    end
    return true
end

local function waitFor(fn, timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 10) do
        local ok, v = pcall(fn)
        if ok and v then return v end
        task.wait(0.1)
    end
    return nil
end

local function waitDialogueOption1()
    return waitFor(function()
        local ui = PlayerGui:FindFirstChild("DialogueUI")
        if not ui then return nil end
        local list = ui:FindFirstChild("MainFrame")
            and ui.MainFrame:FindFirstChild("ResponseFrame")
            and ui.MainFrame.ResponseFrame:FindFirstChild("List")
        local opt1 = list and list:FindFirstChild("1")
        if opt1 and opt1:IsA("GuiObject") and opt1.AbsoluteSize.X > 2 then
            return opt1
        end
        return nil
    end, 12)
end

local function waitShop()
    return waitFor(function()
        local shop = PlayerGui:FindFirstChild("Shop")
        if not shop then return nil end
        local main = shop:FindFirstChild("Main")
        if main and main:FindFirstChild("ScrollingFrame") then return shop end
        return nil
    end, 8)
end

local function buyOneEachAndExit()
    local shop = PlayerGui:FindFirstChild("Shop")
    if not shop then return false end
    local main = shop:FindFirstChild("Main")
    local scroll = main and main:FindFirstChild("ScrollingFrame")
    if not scroll then return false end

    local items = {}
    for _, child in ipairs(scroll:GetChildren()) do
        if child.Name == "PurchaseableItem" then
            table.insert(items, child)
        end
    end
    table.sort(items, function(a, b)
        return a.AbsolutePosition.Y < b.AbsolutePosition.Y
    end)

    local count = math.min(3, #items)
    notify("Comprando 1 de cada (" .. count .. ")...")
    for i = 1, count do
        clickOnce(items[i])
        task.wait(0.5)
    end

    task.wait(0.25)
    local exitBtn = main:FindFirstChild("Exit")
    if exitBtn then
        notify("EXIT")
        clickOnce(exitBtn)
    end
    return true
end

-- ==================== MAIN ====================
task.spawn(function()
    notify("Iniciando...")

    if not travelToShop() then
        notify("Fallo viaje")
        return
    end
    task.wait(0.35)

    local npc = getLamont()
    if not npc then
        notify("No Lamont Bell")
        destroyPlatform()
        return
    end

    local prompt, torso = getLamontPrompt(npc)
    if not prompt then
        notify("No ProximityPrompt")
        destroyPlatform()
        return
    end

    local lookPos = (torso and torso.Position) or npc:GetPivot().Position

    notify("Fijando camara...")
    startLookAt(lookPos)
    task.wait(0.35)

    notify("Proximity 40 studs...")
    enlargeAndFirePrompt(prompt)

    notify("Esperando dialogo...")
    local opt1 = waitDialogueOption1()
    if not opt1 then
        notify("No dialogo")
        stopLookAt()
        destroyPlatform()
        return
    end

    task.wait(0.3)
    notify("Click opcion 1")
    clickOnce(opt1)

    notify("Esperando Shop...")
    if not waitShop() then
        notify("Shop no abrio")
        stopLookAt()
        destroyPlatform()
        return
    end

    task.wait(0.35)
    buyOneEachAndExit()

    stopLookAt()
    -- Ya compre: ahora si se puede quitar la plataforma (opcional)
    -- destroyPlatform()
    notify("Listo")
end)
