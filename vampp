if getgenv().GravityHubLoaded then
    warn("[GravityHub] Ya esta cargado")
    return
end
getgenv().GravityHubLoaded = true

getgenv().ValaryLibraryLoaded = nil
getgenv().Library = nil

local LIBRARY_URL = "https://raw.githubusercontent.com/psycotticc/farmeooooo/refs/heads/main/library%20valary"
local SCRIPT_URL = "https://raw.githubusercontent.com/psycotticc/farmeooooo/refs/heads/main/xddd"

local okLib, Library = pcall(function()
    local src = game:HttpGet(LIBRARY_URL)
    local fn, err = loadstring(src)
    if not fn then error(err or "loadstring library failed") end
    return fn()
end)

if not okLib or not Library then
    getgenv().GravityHubLoaded = nil
    warn("[GravityHub] No se pudo cargar la libreria:", Library)
    return
end

getgenv().Library = Library

local okScript, errScript = pcall(function()
    local src = game:HttpGet(SCRIPT_URL)
    local fn, err = loadstring(src)
    if not fn then error(err or "loadstring script failed") end
    return fn()
end)

if not okScript then
    getgenv().GravityHubLoaded = nil
    warn("[GravityHub] No se pudo cargar el script:", errScript)
    return
end
