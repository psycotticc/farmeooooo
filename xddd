local function PlaceUnderPot(farmPot)
    local potPart = GetPotPart(farmPot)
    if not potPart then return end
    if not EnsurePlatform() then return end
    local underPos = potPart.Position - Vector3.new(0, UNDER_POT_OFFSET, 0)
    SetStatus("Colocando debajo de la olla...")
    local tw = TweenService:Create(currentPlatform, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(underPos.X, underPos.Y - 4.3, underPos.Z)
    })
    tw:Play()
    tw.Completed:Wait()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = CFrame.new(underPos) end
    StartLookAt(potPart.Position)
    EnlargePotPrompt(farmPot)
end

local function GoToOwnedCookingPot()
    local apt, aptName, aptFolder = FindOwnedApartment()
    if not apt then
        SetStatus("Sin depa — comprando...")
        if not BuyApartmentWithPot() then return false end
        apt, aptName, aptFolder = FindOwnedApartment()
        if not apt then return false end
    end

    local pots = GetCookingPots(apt)
    if #pots == 0 and aptFolder then pots = GetCookingPots(aptFolder) end
    local farmPot = pots[1]
    if not farmPot then
        SetStatus("No se encontro Cooking Pot")
        return false
    end
    if #pots > 1 then
        for i = 2, #pots do pcall(function() pots[i]:Destroy() end) end
        farmPot = pots[1]
    end

    ClearAroundPot(apt, farmPot, 16)
    local underCF = GetUnderPotCFrame(farmPot)
    if not underCF then return false end

    SetStatus("Yendo al depa (" .. tostring(aptName) .. ")...")
    local ok = SlowTravelUnderMap(underCF, "Viajando debajo de la olla...", 25, 4.5)
    if not ok then return false end
    if not AutoMS then return false end

    if not farmPot.Parent then
        local left = GetCookingPots(apt)
        if #left == 0 and aptFolder then left = GetCookingPots(aptFolder) end
        farmPot = left[1]
    end
    if not farmPot then return false end

    ClearAroundPot(apt, farmPot, 16)
    PlaceUnderPot(farmPot)
    SetStatus("Debajo de la olla")
    return true, farmPot
end

