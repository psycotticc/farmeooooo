            SetStatus("No se pudo comprar")
        end

        task.wait(0.35)
        return success
    end)

    if not okAll then
        warn("[GravityHub] FinishFarmAndSell error:", errAll)
        StopLookAt()
        DestroyPlatform()
        SetStatus("Error en venta, reintentando...")
        return false
    end

    return errAll == true
end

local function CanDelete(obj)
    if not obj or not obj.Parent then return false end
    if IsProtectedObject(obj) then return false end
    if obj.Size.X > 250 and obj.Size.Z > 250 then return false end
    if obj.Position.Y < -30 then return false end
    return obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation")
end

