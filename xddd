-- ==================== LOAD VALARY LIBRARY (mobile-safe) ====================
getgenv().ValaryLibraryLoaded = nil
getgenv().Library = nil

local Library
do
    local LIB_URL = "https://raw.githubusercontent.com/psycotticc/farmeooooo/refs/heads/main/library%20valary"

    local function httpGet(url)
        local ok, res = pcall(function()
            if syn and syn.request then
                local r = syn.request({ Url = url, Method = "GET" })
                return r and r.Body
            elseif http and http.request then
                local r = http.request({ Url = url, Method = "GET" })
                return r and r.Body
            elseif request then
                local r = request({ Url = url, Method = "GET" })
                return r and r.Body
            elseif http_request then
                local r = http_request({ Url = url, Method = "GET" })
                return r and r.Body
            elseif fluxus and fluxus.request then
                local r = fluxus.request({ Url = url, Method = "GET" })
                return r and r.Body
            else
                return game:HttpGet(url)
            end
        end)
        if ok and type(res) == "string" and #res > 500 then
            return res
        end
        return nil
    end

    local src = httpGet(LIB_URL)

    -- NO usar Valary_UI_Library_Standalone.lua (en Delta/celular rompe)
    if not src then
        warn("[GravityHub] No se pudo descargar la libreria Valary (revisa internet / HttpGet)")
        return
    end

    local okLoad, chunkOrErr = pcall(loadstring, src)
    if not okLoad or type(chunkOrErr) ~= "function" then
        warn("[GravityHub] loadstring error:", chunkOrErr)
        return
    end

    local okRun, result = pcall(chunkOrErr)
    if okRun and type(result) == "table" then
        Library = result
        getgenv().Library = result
    else
        warn("[GravityHub] Library runtime error:", result)
        Library = getgenv().Library
    end
end

if not Library then
    warn("[GravityHub] Failed to load Valary Library: nil")
    return
end

