end

local function fireConnections(obj)
    if not obj then return 0 end
    local n = 0
    local signals = {
        "Activated",
        "MouseButton1Click",
        "MouseButton1Down",
        "MouseButton1Up",
        "TouchTap",
        "TouchLongPress",
        "InputBegan",
        "SelectionGained",
    }

    -- firesignal (muchos executors mobile lo soportan mejor)
    if firesignal then
        for _, name in ipairs(signals) do
            pcall(function()
                local sig = obj[name]
                if typeof(sig) == "RBXScriptSignal" then
                    firesignal(sig)
                    n += 1
                end
            end)
        end
    end

    if getconnections then
        for _, name in ipairs(signals) do
            pcall(function()
                local sig = obj[name]
                if typeof(sig) == "RBXScriptSignal" then
                    for _, c in ipairs(getconnections(sig)) do
                        pcall(function()
                            if c.Fire then
                                c:Fire()
                                n += 1
                            elseif c.Function then
                                c.Function()
                                n += 1
                            end
                        end)
                    end
                end
            end)
        end
    end

    pcall(function()
        if typeof(obj.Activate) == "function" then
            obj:Activate()
            n += 1
        end
    end)
    return n
end

local function getGuiScreenPoint(gui)
    if not gui then return nil end
    local absPos = gui.AbsolutePosition
    local absSize = gui.AbsoluteSize
    if not absPos or not absSize then return nil end
    if absSize.X < 1 or absSize.Y < 1 then return nil end

    -- En mobile el topbar mueve las coords; hay que sumar GuiInset
    local inset = Vector2.new(0, 0)
    pcall(function()
        inset = GuiService:GetGuiInset()
    end)

    local x = absPos.X + absSize.X / 2
    local y = absPos.Y + absSize.Y / 2 + (inset.Y or 0)
    return x, y
end

local function tapGuiAt(gui)
    if not gui then return false end
    local ok = false
    local x, y = getGuiScreenPoint(gui)
    if not x then return false end

    -- 1) Mouse events (PC + varios executors mobile)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(isMobile and 0.06 or 0.03)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
        ok = true
    end)

    -- 2) Touch events (firmas distintas segun executor)
    pcall(function()
        if VirtualInputManager.SendTouchEvent then
            -- intento A
            pcall(function()
                VirtualInputManager:SendTouchEvent(1, true, x, y)
                task.wait(0.05)
                VirtualInputManager:SendTouchEvent(1, false, x, y)
                ok = true
            end)
            -- intento B
            pcall(function()
                VirtualInputManager:SendTouchEvent(x, y, 0, true)
                task.wait(0.05)
                VirtualInputManager:SendTouchEvent(x, y, 0, false)
                ok = true
            end)
        end
    end)

    -- 3) Sin inset por si el executor ya lo aplica
    pcall(function()
        local absPos = gui.AbsolutePosition
        local absSize = gui.AbsoluteSize
        local x2 = absPos.X + absSize.X / 2
        local y2 = absPos.Y + absSize.Y / 2
        VirtualInputManager:SendMouseButtonEvent(x2, y2, 0, true, game, 0)
        task.wait(0.04)
        VirtualInputManager:SendMouseButtonEvent(x2, y2, 0, false, game, 0)
        ok = true
    end)

    return ok
end

local function clickGui(gui)
    if not gui then return 0 end
    local n = 0

    local function clickOne(obj)
        if not obj then return end
        -- asegurar visible / activo
        pcall(function()
            if obj:IsA("GuiObject") then
                obj.Visible = true
                if obj:IsA("GuiButton") then
                    obj.Active = true
                end
            end
        end)
        n += fireConnections(obj)
        tapGuiAt(obj)
    end

    clickOne(gui)

    pcall(function()
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("GuiButton") or d:IsA("TextButton") or d:IsA("ImageButton") then
                clickOne(d)
            end
        end
    end)

    -- en mobile a veces el click real esta en un Frame hijo grande
    if isMobile then
        pcall(function()
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("Frame") or d:IsA("TextLabel") or d:IsA("ImageLabel") then
                    local sz = d.AbsoluteSize
                    if sz and sz.X > 20 and sz.Y > 20 then
                        fireConnections(d)
                        tapGuiAt(d)
                    end
                end
            end
        end)
    end

    return n
end

local function waitFor(fn, timeout)
    timeout = timeout or 8
    local t = tick()
    while tick() - t < timeout do
        local ok, v = pcall(fn)
        if ok and v then return v end
        task.wait(0.1)
    end
    return nil
end

