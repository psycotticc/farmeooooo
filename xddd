local function AutoBuyIngredients(amount)
    if not AutoMS then return false end
    amount = math.clamp(math.floor(amount or farmAmount or 1), 1, 50)

    -- If shop already open → buy directly
    if LocalPlayer.PlayerGui:FindFirstChild("Shop") then
