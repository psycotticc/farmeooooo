-- ==================== AUTO MS LOOP ====================
local function StartAutoMS()
    if AutoMS then return end
    AutoMS = true
    FarmStartTime = tick()
    ApproxStartTime = 0
    ApproxActive = false
    SetStatus("Iniciando...")
    task.spawn(function()
        local firstCycle = true

        while AutoMS do
            local okCycle, errCycle = pcall(function()
                if firstCycle then
                    if not FindOwnedApartment() then
                        local free = FindFreeCompactWalkup()
                        if not free then
                            SetStatus("Depas Llenos")
                            AutoMS = false
                            return
                        end
                        SetStatus("Sin depa — comprando...")
                        if not BuyApartmentWithPot() then
                            task.wait(2)
                            return
                        end
                    end
                    if not AutoMS then return end

                    if not SlowTravelUnderMap(ShopPosition, "Yendo a tienda...", 25, 4.5) then
                        if not AutoMS then return end
                        task.wait(1)
                        return
                    end
                    if not AutoMS then return end
                    DestroyPlatform()
                    ClearBlockersNear(ShopPosition.Position, SHOP_CLEAR_RADIUS)
                    task.wait(0.3)
                    if not AutoMS then return end

                    if not AutoBuyIngredients(farmAmount) then
                        SetStatus("Fallo compra — reintentando...")
                        task.wait(1.5)
                        return
                    end
                    if not AutoMS then return end
                    firstCycle = false
                end

                local ok, farmPot = GoToOwnedCookingPot()
                if not ok then
                    SetStatus("Fallo depa — reintentando...")
                    task.wait(1.5)
                    return
                end
                if not AutoMS then return end

                local potPart = farmPot and GetPotPart(farmPot)
                if potPart then StartLookAt(potPart.Position) end
                EnlargePotPrompt(farmPot)

                while AutoMS do
                    CheckLimitCash()
                    if HasNoIngredients() then break end
                    if potPart and potPart.Parent then
                        ClearAroundPot(nil, farmPot, 14)
                        PlaceUnderPot(farmPot)
                        StartLookAt(potPart.Position)
                        EnlargePotPrompt(farmPot)
                    elseif farmPot and farmPot.Parent then
                        potPart = GetPotPart(farmPot)
                    end

                    SetStatus("Poniendo Water...")
                    local usedWater = EquipAndUse2Times("Water")
                    -- Approximate time starts on first water in pot
                    if usedWater and not ApproxActive then
                        ApproxActive = true
                        ApproxStartTime = tick()
                    end
                    if not AutoMS then break end
                    GoDownAndUp(18)
                    if not AutoMS then break end
                    PlaceUnderPot(farmPot)
                    if potPart then StartLookAt(potPart.Position) end
                    SetStatus("Poniendo Sugar...")
                    EquipAndUse2Times("Sugar Block Bag")
                    if not AutoMS then break end
                    task.wait(1.3)
                    if not AutoMS then break end
                    SetStatus("Poniendo Gelatin...")
                    EquipAndUse2Times("Gelatin")
                    if not AutoMS then break end
                    GoDownAndUp(43)
                    if not AutoMS then break end
                    PlaceUnderPot(farmPot)
                    if potPart then StartLookAt(potPart.Position) end
                    SetStatus("Usando Empty Bag...")
                    local empty = GetTool("Empty Bag") or GetTool("Empty") or GetTool("Bag")
                    if empty then EquipAndUse2Times(empty.Name) end
                    SetStatus("Ciclo olla...")
                    task.wait(1.0)
                end
                if not AutoMS then return end

                local boughtAgain = FinishFarmAndSell()
                if not AutoMS then return end
                if not boughtAgain then
                    SetStatus("No se pudo comprar, reintentando...")
                    task.wait(1.5)
                    return
                end
                SetStatus("Yendo al depa despues de comprar...")
                task.wait(0.3)
            end)

            if not okCycle then
                SetStatus("Error ciclo — reintentando...")
                pcall(DestroyPlatform)
                task.wait(1.5)
            end
            if not AutoMS then break end
            if CurrentStatus == "Depas Llenos" then break end
        end

        StopLookAt()
        if isProtecting and currentPlatform then ForceGoUp() end
        if CurrentStatus ~= "Depas Llenos" then SetStatus("Detenido") end
    end)
end

local function StopAutoMS()
    if not AutoMS then return end
    AutoMS = false
    StopLookAt()
    if FarmStartTime > 0 then
        AccumulatedTime = AccumulatedTime + (tick() - FarmStartTime)
    end
    ApproxActive = false
    SetStatus("Deteniendo...")
    task.spawn(function()
        if isProtecting and currentPlatform then ForceGoUp() else SetStatus("Detenido") end
    end)
end

