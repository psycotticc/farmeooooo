local function SetStatus(text)
    CurrentStatus = text or CurrentStatus
end

local function FormatTime(sec)
    sec = math.max(0, math.floor(sec or 0))
    local m = math.floor(sec / 60)
    local s = sec % 60
    if m > 0 then
        return m .. "m " .. s .. "s"
    end
    return s .. "s"
end

local function GetPlayerMoney()
    local ok, result = pcall(function()
        local amount = LocalPlayer.PlayerGui:FindFirstChild("PlayerUI")
            and LocalPlayer.PlayerGui.PlayerUI:FindFirstChild("Money")
            and LocalPlayer.PlayerGui.PlayerUI.Money:FindFirstChild("Amount")
        if not amount then return 0 end
        local text = tostring(amount.Text or amount.Value or "0")
        local digits = string.gsub(text, "[^%d]", "")
        return tonumber(digits) or 0
    end)
    return (ok and result) or 0
end

