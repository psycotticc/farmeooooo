local cachedSellPrompt = nil

local function GetLamontPrompt()
    if cachedSellPrompt and cachedSellPrompt.Parent then
        return cachedSellPrompt
    end
    local ok, prompt = pcall(function()
        local npc = workspace:FindFirstChild("Folders")
            and workspace.Folders:FindFirstChild("NPCs")
            and workspace.Folders.NPCs:FindFirstChild("Lamont Bell")
        if not npc then return nil end
