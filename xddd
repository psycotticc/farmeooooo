        local p = torso and torso:FindFirstChildOfClass("ProximityPrompt")
        if not p then p = npc:FindFirstChildWhichIsA("ProximityPrompt", true) end
        return p
    end)
    if ok and prompt then
        cachedSellPrompt = prompt
        EnlargePrompt(prompt, 50)
        return prompt
    end
    return nil
end

local function HoldSellPrompt()
    local prompt = GetLamontPrompt()
    if prompt then
        local holdTime = (prompt.HoldDuration and prompt.HoldDuration > 0) and (prompt.HoldDuration + 0.15) or 0.55
        pcall(function() if fireproximityprompt then fireproximityprompt(prompt, holdTime) end end)
        pcall(function() prompt:InputHoldBegin() end)
        task.wait(holdTime)
        pcall(function() prompt:InputHoldEnd() end)
        return true
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        return HoldAnyPromptNear(hrp.Position, 40)
    end
    return false
