local function SellAllBags()
    SetStatus("Vendiendo bolsas...")

    -- Parar look/platform para no pelear con el personaje
    StopLookAt()
    DestroyPlatform()

    local order = {
        "Small Marshmallow Bag",
        "Medium Marshmallow Bag",
        "Large Marshmallow Bag",
    }

    -- Prompt del NPC una sola vez (no escanear workspace por bolsa)
    local prompt, lookPos = GetLamontPrompt()
    if lookPos then
        pcall(function() StartLookAt(lookPos) end)
    end

    local safety = 0
    local maxLoops = 25
    local stuckCount = 0

    while AutoMS and safety < maxLoops do
        safety += 1

        local okIter, errIter = pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp or hum.Health <= 0 then return end

            local bagName = nil
            for _, name in ipairs(order) do
                if GetToolCount(name) > 0 then
                    bagName = name
                    break
                end
            end
            if not bagName then
                stuckCount = 99 -- salir
                return
            end

            local before = GetToolCount(bagName)
            local tool = GetTool(bagName)
            if not tool or not tool.Parent then
                stuckCount += 1
                return
            end

            SetStatus("Vendiendo " .. bagName .. "...")

            -- Equip
            pcall(function() hum:EquipTool(tool) end)
            task.wait(0.25)

            -- Reobtener prompt si se invalido
            if not prompt or not prompt.Parent then
                prompt, lookPos = GetLamontPrompt()
                if lookPos then
                    pcall(function() StartLookAt(lookPos) end)
                end
            end

            if prompt and prompt.Parent then
                FireSellPrompt(prompt)
            else
                -- fallback minimo
                HoldSellPrompt()
            end

            task.wait(0.55)

            local after = GetToolCount(bagName)
            local sold = before - after
            if sold > 0 then
                TotalMoneyMade += sold * (BAG_PRICES[bagName] or 0)
                stuckCount = 0
            else
                stuckCount += 1
            end

            pcall(CheckLimitCash)
            task.wait(0.12)
        end)

        if not okIter then
            warn("[GravityHub] Sell iter error:", errIter)
            task.wait(0.4)
        end

        -- si no vende 4 veces seguidas, cortar para no crashear/loop
        if stuckCount >= 4 then
            break
        end
        if stuckCount >= 99 then
            break
        end
    end

    StopLookAt()
    SetStatus("Venta terminada")
    pcall(CheckLimitCash)
end

