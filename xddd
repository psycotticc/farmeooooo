local function BuyItemsFromShop(amount)
    local shop = waitFor(function()
        return LocalPlayer.PlayerGui:FindFirstChild("Shop")
    end, isMobile and 7 or 5)
    if not shop then return false end

    task.wait(isMobile and 0.55 or 0.35)
    if not AutoMS then return false end

    local main = shop:FindFirstChild("Main")
    local scrolling = main and main:FindFirstChild("ScrollingFrame")
    if not scrolling then return false end

    local children = scrolling:GetChildren()
    local targets, seen = {}, {}
    local function addTarget(obj)
        if obj and not seen[obj] then
            seen[obj] = true
            table.insert(targets, obj)
        end
    end
    addTarget(children[5])
    addTarget(children[6])
    addTarget(scrolling:FindFirstChild("PurchaseableItem"))
    for _, c in ipairs(children) do
        if c.Name == "PurchaseableItem" then addTarget(c) end
        pcall(function()
            local n = string.lower(c.Name or "")
            if string.find(n, "purchase", 1, true)
                or string.find(n, "buy", 1, true)
                or string.find(n, "item", 1, true)
                or string.find(n, "water", 1, true)
                or string.find(n, "sugar", 1, true)
                or string.find(n, "gelatin", 1, true) then
                addTarget(c)
            end
        end)
    end

    -- mobile: si no encuentra targets tipicos, usa frames visibles del scroll
    if #targets == 0 or isMobile then
        for _, c in ipairs(children) do
            if c:IsA("Frame") or c:IsA("TextButton") or c:IsA("ImageButton") then
