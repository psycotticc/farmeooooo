local function SellAllBags()
    SetStatus("Vendiendo bolsas...")
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local order = {
        "Small Marshmallow Bag",
        "Medium Marshmallow Bag",
        "Large Marshmallow Bag",
    }

    local maxLoops = 40
    local failStreak = 0

    for _ = 1, maxLoops do
        if not AutoMS then break end
        local okLoop, err = pcall(function()
            local bagName = nil
            for _, name in ipairs(order) do
                if GetToolCount(name) > 0 then
                    bagName = name
                    break
                end
            end
            if not bagName then
                failStreak = 99
                return
            end

            local before = GetToolCount(bagName)
            local tool = GetTool(bagName)
            if not tool then
                failStreak += 1
                return
            end

            SetStatus("Vendiendo " .. bagName .. "...")
            pcall(function() hum:EquipTool(tool) end)
            task.wait(0.2)
            HoldSellPrompt()
            task.wait(0.45)

            local after = GetToolCount(bagName)
            local sold = before - after
            if sold > 0 then
                TotalMoneyMade += sold * (BAG_PRICES[bagName] or 0)
                failStreak = 0
            else
                failStreak += 1
            end
            CheckLimitCash()
        end)
        if not okLoop then
            failStreak += 1
        end
        if failStreak >= 4 then break end
        task.wait(0.15)
    end

    SetStatus("Venta terminada")
    CheckLimitCash()
end

local function FinishFarmAndSell()
    local okAll, result = pcall(function()
        StopLookAt()
        SetStatus("Yendo a vender...")

        if not SlowTravelUnderMap(SellPosition, "Viajando a venta...", TravelTime, 4.5) then
            return false
        end
        if not AutoMS then return false end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        DestroyPlatform()

        if hrp and hrp.Parent then
            local sellPos = SellPosition.Position
            hrp.CFrame = CFrame.new(sellPos.X, sellPos.Y + 3, sellPos.Z)
        end

        task.wait(0.35)
        StartLookAt(SellPosition.Position)
        SellAllBags()
        if not AutoMS then return false end

        StopLookAt()
        DestroyPlatform()
        SetStatus("Venta terminada - comprando...")

        task.wait(0.5)

        local success = false
        for attempt = 1, 4 do
            if not AutoMS then break end
            SetStatus("Abriendo menu de compra... (" .. attempt .. "/4)")
            if AutoBuyIngredients(farmAmount) then
                success = true
                break
            end
            task.wait(1.0)
        end

        if success then
            SetStatus("Compra lista - yendo al depa")
        else
            SetStatus("No se pudo comprar")
        end

        task.wait(0.3)
        return success
    end)
    if not okAll then
        SetStatus("Error en venta/compra")
        pcall(DestroyPlatform)
        return false
    end
    return result
end

