    -- Only the 3 real items once each (Water, Sugar, Gelatin)
    local found = {}
    local order = {}
    local keywords = {
        { key = "water", label = "Water" },
        { key = "sugar", label = "Sugar" },
        { key = "gelatin", label = "Gelatin" },
    }

    local function matches(obj, key)
        local n = string.lower(obj.Name or "")
        if string.find(n, key, 1, true) then return true end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                local t = string.lower(d.Text or "")
                if string.find(t, key, 1, true) then return true end
            end
        end
        return false
    end

    for _, child in ipairs(scrolling:GetChildren()) do
        if child.Name == "PurchaseableItem" or child:IsA("Frame") or child:IsA("TextButton") or child:IsA("ImageButton") then
            for _, kw in ipairs(keywords) do
                if not found[kw.key] and matches(child, kw.key) then
                    found[kw.key] = child
                    table.insert(order, child)
                end
            end
        end
    end

    -- Fallback: first 3 PurchaseableItem only (no duplicates from children[5]/[6])
    if #order < 3 then
        order = {}
        found = {}
        for _, child in ipairs(scrolling:GetChildren()) do
            if child.Name == "PurchaseableItem" and not found[child] then
                found[child] = true
                table.insert(order, child)
                if #order >= 3 then break end
            end
        end
    end

    return order
end

local function BuyFromOpenShop(amount)
    amount = math.clamp(math.floor(amount or 1), 1, 50)
    local shop = LocalPlayer.PlayerGui:FindFirstChild("Shop")
    if not shop then return false end
    local main = shop:FindFirstChild("Main")
    local scrolling = main and main:FindFirstChild("ScrollingFrame")
    if not scrolling then return false end

    local targets = FindShopItems(scrolling)
    if #targets == 0 then
        SetStatus("No items en shop")
        return false
    end

    SetStatus("Comprando x" .. amount .. "...")
    for round = 1, amount do
        if not AutoMS then return false end
        for _, item in ipairs(targets) do
            if not AutoMS then return false end
            clickGui(item)
            task.wait(isMobile and 0.35 or 0.25)
            if isMobile then
                clickGui(item)
                task.wait(0.15)
            end
        end
        task.wait(0.15)
    end

    local exitBtn = main and main:FindFirstChild("Exit")
    if exitBtn then
        task.wait(0.15)
        clickGui(exitBtn)
    end
    task.wait(0.3)
    SetStatus("Compra lista")
    return true
end

