    stateLbl.Name = "State"
    stateLbl.Size = UDim2.new(0, 55, 0, 20)
    stateLbl.Position = UDim2.new(1, -95, 0, 7)
    stateLbl.BackgroundTransparency = 1
    stateLbl.Font = Enum.Font.Gotham
    stateLbl.TextSize = 11
    stateLbl.TextColor3 = Color3.fromRGB(220, 50, 50)
    stateLbl.TextXAlignment = Enum.TextXAlignment.Right
    stateLbl.Text = "disabled"
    stateLbl.Parent = frame

    local function makeLine(name, y, text)
        local lbl = Instance.new("TextLabel")
        lbl.Name = name
        lbl.Size = UDim2.new(1, -20, 0, 18)
        lbl.Position = UDim2.new(0, 10, 0, y)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12
        lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Text = text
        lbl.Parent = frame
        return lbl
    end

    local LblMoneyBefore = makeLine("MoneyBefore", 32, "money before : $" .. tostring(MoneyBefore))
    local LblAllMs = makeLine("AllMs", 52, "all ms : 0")
    local LblTotalTime = makeLine("TotalTime", 72, "total time : 0s")
    local LblApprox = makeLine("Approx", 92, "approximate time : --")

    -- drag
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    task.spawn(function()
        while StatusGui and StatusGui.Parent do
            pcall(function()
                local water = GetToolCount("Water")
                local sugar = GetToolCount("Sugar Block Bag")
                local gelatin = GetToolCount("Gelatin")
                local allMs = math.min(water, sugar, gelatin)

                LblMoneyBefore.Text = "money before : $" .. tostring(MoneyBefore)
                LblAllMs.Text = "all ms : " .. tostring(allMs)

                local totalSec = AccumulatedTime
                if AutoMS and FarmStartTime > 0 then
                    totalSec = AccumulatedTime + (tick() - FarmStartTime)
                end
                LblTotalTime.Text = "total time : " .. FormatTime(totalSec)

                -- approximate time starts only after first water in pot
                if ApproxActive and ApproxStartTime > 0 then
                    local totalApprox = farmAmount * SECONDS_PER_UNIT
                    local elapsed = tick() - ApproxStartTime
                    local remaining = math.max(0, totalApprox - elapsed)
                    LblApprox.Text = "approximate time : " .. FormatTime(remaining)
                else
                    local totalApprox = farmAmount * SECONDS_PER_UNIT
                    LblApprox.Text = "approximate time : " .. FormatTime(totalApprox)
                end

                if AutoMS then
                    circle.BackgroundColor3 = Color3.fromRGB(50, 220, 90)
                    stateLbl.TextColor3 = Color3.fromRGB(50, 220, 90)
                    stateLbl.Text = "active"
                else
                    circle.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
                    stateLbl.TextColor3 = Color3.fromRGB(220, 50, 50)
                    stateLbl.Text = "disabled"
                end
            end)
            task.wait(0.25)
        end
    end)
end

